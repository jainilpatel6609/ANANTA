# ANANTA TRADERS - Backend Environment Configuration

PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/ananta_traders
JWT_SECRET=ananta_traders_super_secure_jwt_secret_key_2026_production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Razorpay Configuration (Get keys from https://dashboard.razorpay.com/)
RAZORPAY_KEY_ID=rzp_test_ananta_mock_key
RAZORPAY_KEY_SECRET=rzp_test_ananta_mock_secret

# Active payment gateway: ICICI or RAZORPAY
PAYMENT_GATEWAY=ICICI

# ICICI Orange PG Configuration (UAT base URL below; switch to https://pgpay.icicibank.com at go-live)
ICICI_BASE_URL=https://pgpayuat.icicibank.com
ICICI_MERCHANT_ID=
ICICI_AGGREGATOR_ID=
ICICI_SECRET_KEY=

# Cloudinary Storage Configuration (Optional - falls back to local /uploads if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# External API Integrations (Optional)
GOOGLE_MAPS_API_KEY=
# Separate, Routes-API-restricted key used only for road-distance calculation (RoadDistanceService)
GOOGLE_ROUTES_API_KEY=
SMS_API_KEY=
WHATSAPP_API_KEY=
