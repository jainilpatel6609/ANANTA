# ANANTA TRADERS Android app configuration (copy to `.env`).
# After editing, restart Metro with a cache reset: npx react-native start --reset-cache

# URL of the deployed ANANTA TRADERS web app (the delivery-app frontend) that the app loads in the WebView.
# REQUIRED for release builds. Must be https.
WEB_APP_URL=

# Deployed ANANTA backend API (same value as VITE_API_URL in delivery-app/.env).
# Used by native live-location sharing to reach the existing backend.
API_URL=https://ananta-m9ro.onrender.com/api

# Debug builds only: the frontend dev server. 10.0.2.2 is the host machine as seen from the Android emulator;
# for a physical device use your computer's LAN IP (e.g. http://192.168.1.10:3000).
DEV_WEB_APP_URL=http://10.0.2.2:3000
